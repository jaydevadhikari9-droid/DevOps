pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Checking Python availability...'
                bat 'python --version'
                bat 'python -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                bat 'python -m unittest discover -s . -p "test_*.py" -v'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Preparing deployment directory...'
                bat '''
                    if not exist python-app-deploy mkdir python-app-deploy
                    copy /Y app.py python-app-deploy\\app.py
                    copy /Y requirements.txt python-app-deploy\\requirements.txt
                '''
            }
        }

               stage('Test Application') {
            steps {
                echo 'Checking application response with Flask test client...'
                bat 'python -m unittest discover -s . -p "test_*.py" -v'
            }
        }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
