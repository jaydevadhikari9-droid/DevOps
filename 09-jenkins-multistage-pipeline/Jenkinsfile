
pipeline {
    agent { label 'python-runner' }

    stages {
        stage('Build') {
            steps {
                echo 'Checking Python availability...'
                sh 'python --version'
                sh 'python -m venv .venv-ci'
                sh '.venv-ci/bin/python -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '.venv-ci/bin/python -m unittest discover -s . -p "test_*.py" -v'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Preparing deployment directory...'
                sh 'mkdir -p python-app-deploy'
                sh 'cp app.py requirements.txt python-app-deploy/'
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking application response with Flask test client...'
                sh '.venv-ci/bin/python -m unittest discover -s . -p "test_*.py" -v'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
